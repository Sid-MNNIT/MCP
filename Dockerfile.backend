# ──────────────────────────────────────────────────────────────
# Node backend (Express + Mongoose + cron)
# ──────────────────────────────────────────────────────────────
FROM node:20-alpine

WORKDIR /app

# Install deps first (better layer caching)
COPY backend/package*.json ./
RUN npm ci --omit=dev

# Copy source
COPY backend/ ./

# Render injects PORT; default to 5000 for local Docker runs
ENV PORT=5000
EXPOSE 5000

# app.listen reads process.env.PORT so this respects Render's injection
CMD ["node", "src/index.js"]
